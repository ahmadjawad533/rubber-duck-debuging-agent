# Rubber Duck Environment Variables Template

# -------------------------------------------------------------
# Backend Environment Variables (AWS Lambda / Local Testing)
# -------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# AWS Region (default: us-east-1)
AWS_REGION=us-east-1

# DynamoDB Table Names (automatically created by AWS SAM template.yaml)
SESSIONS_TABLE=RubberDuckSessions-Production
STATS_TABLE=RubberDuckStats-Production

# Optional: set to true to test locally without calling Gemini
USE_MOCK_LLM=false

# -------------------------------------------------------------
# Frontend Environment Variables (Vite)
# -------------------------------------------------------------
# The public Lambda Function URL generated after running `sam deploy`
# Example: https://xxxxxxxxxxxxxxxxxxxx.lambda-url.us-east-1.on.aws
VITE_API_URL=https://your-lambda-function-url.lambda-url.us-east-1.on.aws
